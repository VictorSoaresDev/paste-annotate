#!/bin/sh
# Start paste-annotate for each active local graphical login.
# apt runs this as root and must return immediately, so the helper is
# launched in the background as that user. A missing display is skipped.
set -eu

launch_user() {
    user=$1
    command -v runuser >/dev/null 2>&1 || return 0
    command -v nohup >/dev/null 2>&1 || return 0

    uid=$(id -u "$user" 2>/dev/null) || return 0
    home=$(getent passwd "$user" | awk -F: 'NR==1 {print $6}')
    [ -n "${home:-}" ] || return 0

    display=""
    xauth=""
    runtime=""
    dbus=""
    session_type=""
    fallback_display=""
    fallback_runtime=""
    fallback_dbus=""
    fallback_type=""

    for pid in $(ps -u "$user" -o pid= 2>/dev/null); do
        [ -r "/proc/$pid/environ" ] || continue
        envtext=$( { tr '\0' '\n' < "/proc/$pid/environ" || true; } 2>/dev/null )
        d=$(printf '%s\n' "$envtext" | sed -n '/^DISPLAY=/{s/^DISPLAY=//; p; q;}')
        [ -n "$d" ] || continue
        a=$(printf '%s\n' "$envtext" | sed -n '/^XAUTHORITY=/{s/^XAUTHORITY=//; p; q;}')
        r=$(printf '%s\n' "$envtext" | sed -n '/^XDG_RUNTIME_DIR=/{s/^XDG_RUNTIME_DIR=//; p; q;}')
        b=$(printf '%s\n' "$envtext" | sed -n '/^DBUS_SESSION_BUS_ADDRESS=/{s/^DBUS_SESSION_BUS_ADDRESS=//; p; q;}')
        t=$(printf '%s\n' "$envtext" | sed -n '/^XDG_SESSION_TYPE=/{s/^XDG_SESSION_TYPE=//; p; q;}')
        if [ -n "$a" ]; then
            display=$d
            xauth=$a
            runtime=$r
            dbus=$b
            session_type=$t
            break
        fi
        if [ -z "$fallback_display" ]; then
            fallback_display=$d
            fallback_runtime=$r
            fallback_dbus=$b
            fallback_type=$t
        fi
    done

    if [ -z "$display" ]; then
        [ -n "$fallback_display" ] || return 0
        display=$fallback_display
        runtime=$fallback_runtime
        dbus=$fallback_dbus
        session_type=$fallback_type
    fi
    [ -n "$runtime" ] || runtime=/run/user/$uid

    if [ -n "${PASTE_ANNOTATE_DRY_RUN:-}" ]; then
        printf '%s\n' "$user display=$display xauthority=$xauth" >> "$PASTE_ANNOTATE_DRY_RUN"
        return 0
    fi

    echo "paste-annotate: starting for the current login of $user" >&2
    # shellcheck disable=SC2086
    nohup runuser -u "$user" -- /usr/bin/env \
        "HOME=$home" \
        "USER=$user" \
        "LOGNAME=$user" \
        "DISPLAY=$display" \
        "XDG_RUNTIME_DIR=$runtime" \
        ${xauth:+"XAUTHORITY=$xauth"} \
        ${dbus:+"DBUS_SESSION_BUS_ADDRESS=$dbus"} \
        ${session_type:+"XDG_SESSION_TYPE=$session_type"} \
        /usr/bin/paste-annotate --replace \
        </dev/null >/dev/null 2>&1 &
}

case "${1:-}" in
    configure)
        command -v loginctl >/dev/null 2>&1 || exit 0
        sessions=$(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}' || true)
        seen=" "
        for sess in $sessions; do
            remote=$(loginctl show-session "$sess" -p Remote --value 2>/dev/null || true)
            [ "$remote" = "yes" ] && continue
            type=$(loginctl show-session "$sess" -p Type --value 2>/dev/null || true)
            case "$type" in
                x11|wayland|mir) ;;
                *) continue ;;
            esac
            active=$(loginctl show-session "$sess" -p Active --value 2>/dev/null || true)
            state=$(loginctl show-session "$sess" -p State --value 2>/dev/null || true)
            if [ "$active" != "yes" ] && [ "$state" != "active" ]; then
                continue
            fi
            user=$(loginctl show-session "$sess" -p Name --value 2>/dev/null || true)
            [ -n "$user" ] && [ "$user" != "root" ] || continue
            case $seen in
                *" $user "*) continue ;;
            esac
            seen="$seen$user "
            launch_user "$user" || true
        done
        ;;
esac

exit 0
