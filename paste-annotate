_bind()

X_ERRORS: list[tuple[int, int, str]] = []


@ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.c_void_p)
def _x_error(_dpy, event_p):
    ev = ctypes.cast(event_p, ctypes.POINTER(XErrorEvent)).contents
    buf = ctypes.create_string_buffer(256)
    x11.XGetErrorText(_dpy, ev.error_code, buf, 255)
    text = buf.value.decode("utf-8", "replace")
    X_ERRORS.append((ev.error_code, ev.request_code, text))
    log(f"X error {ev.error_code} req {ev.request_code}: {text}")
    return 0


@ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p)
def _x_io_error(_dpy):
    log("X connection lost")
    os._exit(1)


class X11:
    def __init__(self) -> None:
        self.dpy = None
        self.fd = -1
        self.root = 0
        self.win = 0
        self.v_code = 0
        self.ctrl_code = 0
        self.atoms: dict[str, int] = {}
        self.known: dict[int, str] = {}
        self.inbox: list[XEvent] = []
        self._closed = False

    def open(self) -> None:
        self.dpy = x11.XOpenDisplay(None)
        if not self.dpy:
            raise SystemExit("cannot open X display")
        x11.XSetErrorHandler(_x_error)
        x11.XSetIOErrorHandler(_x_io_error)
        self.fd = x11.XConnectionNumber(self.dpy)
        self.root = x11.XDefaultRootWindow(self.dpy)
        self.win = x11.XCreateSimpleWindow(self.dpy, self.root, 0, 0, 1, 1, 0, 0, 0)
        x11.XSelectInput(self.dpy, self.win, PropertyChangeMask)
        ev = ctypes.c_int()
        err = ctypes.c_int()
        major = ctypes.c_int()
        minor = ctypes.c_int()
        if not xtst.XTestQueryExtension(self.dpy, ctypes.byref(ev), ctypes.byref(err), ctypes.byref(major), ctypes.byref(minor)):
            raise SystemExit("XTest extension is missing")
        self.v_code = x11.XKeysymToKeycode(self.dpy, 0x0076)
        self.ctrl_code = x11.XKeysymToKeycode(self.dpy, 0xFFE3)
        if not self.v_code or not self.ctrl_code:
            raise SystemExit("cannot resolve Ctrl or V keycode")
        for name in (
            "CLIPBOARD",
            "TARGETS",
            "INCR",
            "UTF8_STRING",
            "STRING",
            "TEXT",
            "COMPOUND_TEXT",
            "text/plain",
            "text/plain;charset=utf-8",
            "_NET_ACTIVE_WINDOW",
            "PA_PROP",
            *IMAGE_MIMES,
        ):
            self._intern(name)
        x11.XFlush(self.dpy)

    def _intern(self, name: str) -> int:
        if name in self.atoms:
            return self.atoms[name]
        atom = x11.XInternAtom(self.dpy, name.encode("utf-8"), False)
        self.atoms[name] = atom
        self.known[atom] = name
        return atom

    def atom_name(self, atom: int, deadline: float | None = None) -> str:
        if atom in self.known:
            return self.known[atom]
        if deadline is not None and time.monotonic() > deadline:
            return ""
        ptr = x11.XGetAtomName(self.dpy, atom)
        if not ptr:
            self.known[atom] = ""
            return ""
        name = ctypes.cast(ptr, ctypes.c_char_p).value.decode("utf-8", "replace")
        x11.XFree(ptr)
        self.known[atom] = name
        return name

    def close(self) -> None:
        if self._closed or not self.dpy:
            return
        self._closed = True
        try:
            self.ungrab()
            x11.XFlush(self.dpy)
            x11.XCloseDisplay(self.dpy)
        except Exception:
            pass
        self.dpy = None

    def grab_masks(self) -> list[int]:
        masks = []
        for bits in range(4):
            extra = 0
            if bits & 1:
                extra |= LockMask
            if bits & 2:
                extra |= Mod2Mask
            masks.append(ControlMask | extra)
        return masks

    def grab(self) -> None:
        before = len(X_ERRORS)
        ok = 0
        for mask in self.grab_masks():
            nerr = len(X_ERRORS)
            x11.XGrabKey(self.dpy, self.v_code, mask, self.root, False, GrabModeAsync, GrabModeSync)
            x11.XSync(self.dpy, False)
            if len(X_ERRORS) == nerr:
                ok += 1
        if ok == 0:
            detail = X_ERRORS[before:]
            raise SystemExit(f"could not grab Ctrl+V ({detail})")
        log(f"grabbed Ctrl+V keycode {self.v_code} ({ok} modifier masks)")

    def ungrab(self) -> None:
        if not self.dpy or not self.v_code:
            return
        x11.XUngrabKey(self.dpy, self.v_code, AnyModifier, self.root)
        x11.XFlush(self.dpy)

    def allow(self, mode: int) -> None:
        x11.XAllowEvents(self.dpy, mode, CurrentTime)
        x11.XFlush(self.dpy)

    def suck(self) -> None:
        while x11.XPending(self.dpy):
            ev = XEvent()
            x11.XNextEvent(self.dpy, ctypes.byref(ev))
            self.inbox.append(ev)

    def read_property(self, window: int, prop: int, delete: bool) -> tuple[int, int, bytes]:
        actual_type = ctypes.c_ulong()
        actual_fmt = ctypes.c_int()
        nitems = ctypes.c_ulong()
        after = ctypes.c_ulong()
        ptr = ctypes.c_void_p()
        x11.XGetWindowProperty(
            self.dpy, window, prop, 0, 0, False, 0,
            ctypes.byref(actual_type), ctypes.byref(actual_fmt),
            ctypes.byref(nitems), ctypes.byref(after), ctypes.byref(ptr),
        )
        if ptr.value:
            x11.XFree(ptr)
        if after.value > MAX_CLIP_BYTES:
            return 0, 0, b""
        long_len = max(1, (after.value + 3) // 4)
        actual_type = ctypes.c_ulong()
        actual_fmt = ctypes.c_int()
        nitems = ctypes.c_ulong()
        after = ctypes.c_ulong()
        ptr = ctypes.c_void_p()
        x11.XGetWindowProperty(
            self.dpy, window, prop, 0, long_len, bool(delete), 0,
            ctypes.byref(actual_type), ctypes.byref(actual_fmt),
            ctypes.byref(nitems), ctypes.byref(after), ctypes.byref(ptr),
        )
        fmt = actual_fmt.value
        count = nitems.value
        if fmt == 32:
            nbytes = count * ctypes.sizeof(ctypes.c_ulong)
        elif fmt == 16:
            nbytes = count * 2
        else:
            nbytes = count
        if nbytes > MAX_CLIP_BYTES:
            if ptr.value:
                x11.XFree(ptr)
            return 0, 0, b""
        data = ctypes.string_at(ptr, nbytes) if ptr.value and nbytes else b""
        if ptr.value:
            x11.XFree(ptr)
        return actual_type.value, fmt, data

    def active_window(self) -> int:
        _typ, fmt, data = self.read_property(self.root, self.atoms["_NET_ACTIVE_WINDOW"], False)
        if fmt != 32 or len(data) < ctypes.sizeof(ctypes.c_ulong):
            return 0
        return struct.unpack("@L", data[: ctypes.sizeof(ctypes.c_ulong)])[0]

    def activate(self, window: int, timestamp: int) -> None:
        if not window:
            return
        ev = XEvent()
        client = ev.client
        client.type = ClientMessage
        client.display = self.dpy
        client.window = window
        client.message_type = self.atoms["_NET_ACTIVE_WINDOW"]
        client.format = 32
        client.data[0] = 1
        client.data[1] = int(timestamp or 0)
        client.data[2] = 0
        client.data[3] = 0
        client.data[4] = 0
        mask = SubstructureNotifyMask | SubstructureRedirectMask
        x11.XSendEvent(self.dpy, self.root, False, mask, ctypes.byref(ev))
        x11.XFlush(self.dpy)

    def key_down(self, keycode: int) -> bool:
        buf = (ctypes.c_ubyte * 32)()
        x11.XQueryKeymap(self.dpy, buf)
        return bool(buf[keycode // 8] & (1 << (keycode % 8)))

    def xtest(self, keycode: int, press: bool) -> None:
        xtst.XTestFakeKeyEvent(self.dpy, keycode, 1 if press else 0, 0)

    def send_paste(self) -> None:
        """Type Ctrl+V. The V events come back through our grab and must be replayed."""
        ctrl_down = self.key_down(self.ctrl_code)
        v_down = self.key_down(self.v_code)
        if v_down:
            self.xtest(self.v_code, False)
        if not ctrl_down:
            self.xtest(self.ctrl_code, True)
        self.xtest(self.v_code, True)
        self.xtest(self.v_code, False)
        if not ctrl_down:
            self.xtest(self.ctrl_code, False)
        x11.XFlush(self.dpy)

    def refresh_mapping(self, ev: XEvent) -> None:
        x11.XRefreshKeyboardMapping(ctypes.byref(ev.mapping))
        self.v_code = x11.XKeysymToKeycode(self.dpy, 0x0076) or self.v_code
        self.ctrl_code = x11.XKeysymToKeycode(self.dpy, 0xFFE3) or self.ctrl_code


_X11_SINGLE: X11 | None = None


def install_x11(x: X11) -> None:
    global _X11_SINGLE
    _X11_SINGLE = x
    atexit.register(x.close)


