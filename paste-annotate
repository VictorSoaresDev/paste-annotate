def _sig(fn, rest, args):
    fn.restype = rest
    fn.argtypes = args


def _bind() -> None:
    vp = ctypes.c_void_p
    u64 = ctypes.c_ulong
    i32 = ctypes.c_int
    u32 = ctypes.c_uint
    cp = ctypes.c_char_p
    _sig(x11.XOpenDisplay, vp, [cp])
    _sig(x11.XCloseDisplay, i32, [vp])
    _sig(x11.XFlush, i32, [vp])
    _sig(x11.XSync, i32, [vp, i32])
    _sig(x11.XPending, i32, [vp])
    _sig(x11.XNextEvent, i32, [vp, ctypes.POINTER(XEvent)])
    _sig(x11.XConnectionNumber, i32, [vp])
    _sig(x11.XDefaultRootWindow, u64, [vp])
    _sig(x11.XCreateSimpleWindow, u64, [vp, u64, i32, i32, u32, u32, u32, u64, u64])
    _sig(x11.XSelectInput, i32, [vp, u64, ctypes.c_long])
    _sig(x11.XInternAtom, u64, [vp, cp, i32])
    _sig(x11.XGetAtomName, vp, [vp, u64])
    _sig(x11.XFree, i32, [vp])
    _sig(x11.XConvertSelection, i32, [vp, u64, u64, u64, u64, u64])
    _sig(
        x11.XGetWindowProperty,
        i32,
        [
            vp,
            u64,
            u64,
            ctypes.c_long,
            ctypes.c_long,
            i32,
            u64,
            ctypes.POINTER(u64),
            ctypes.POINTER(i32),
            ctypes.POINTER(u64),
            ctypes.POINTER(u64),
            ctypes.POINTER(vp),
        ],
    )
    _sig(x11.XDeleteProperty, i32, [vp, u64, u64])
    _sig(x11.XSetErrorHandler, vp, [vp])
    _sig(x11.XSetIOErrorHandler, vp, [vp])
    _sig(x11.XGetErrorText, i32, [vp, i32, cp, i32])
    _sig(x11.XKeysymToKeycode, ctypes.c_ubyte, [vp, u64])
    _sig(x11.XGrabKey, i32, [vp, i32, u32, u64, i32, i32, i32])
