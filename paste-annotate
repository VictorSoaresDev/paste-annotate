def log(msg: str) -> None:
    line = time.strftime("%Y-%m-%d %H:%M:%S") + " " + msg
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        if LOG_PATH.exists() and LOG_PATH.stat().st_size > 262144:
            prev = LOG_PATH.with_suffix(".log.1")
            prev.unlink(missing_ok=True)
            LOG_PATH.replace(prev)
        with LOG_PATH.open("a", encoding="utf-8") as fh:
            fh.write(line + "\n")
    except OSError:
        pass
    if os.environ.get("PASTE_ANNOTATE_DEBUG"):
        print(line, flush=True)


def load_prefs() -> dict:
    try:
        data = json.loads(PREFS_PATH.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        data = {}
    color = str(data.get("color") or SWATCHES[0][2])
    try:
        width = int(data.get("width", 8))
    except (TypeError, ValueError):
        width = 8
    tool = data.get("tool") if data.get("tool") in ("pen", "arrow", "circle") else "pen"
    return {"color": color, "width": max(2, min(36, width)), "tool": tool}


def save_prefs(prefs: dict) -> None:
    try:
        PREFS_PATH.parent.mkdir(parents=True, exist_ok=True)
        tmp = PREFS_PATH.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(prefs), encoding="utf-8")
        tmp.replace(PREFS_PATH)
    except OSError as exc:
        log(f"prefs not saved: {exc}")


def hex_rgb(value: str) -> tuple[int, int, int]:
    value = value.strip().lstrip("#")
    if len(value) != 6:
        return (255, 43, 43)
    try:
        return (int(value[0:2], 16), int(value[2:4], 16), int(value[4:6], 16))
    except ValueError:
        return (255, 43, 43)


def is_text_name(name: str) -> bool:
    low = name.lower()
    return low in TEXT_NAMES or low.startswith("text/plain")


def is_image_name(name: str) -> bool:
    low = name.lower()
    return low.startswith("image/") or low == "application/x-qt-image"


def classify_names(names: list[str]) -> str:
    saw_image = False
    saw_text = False
    for name in names:
        if is_text_name(name):
            saw_text = True
        elif is_image_name(name):
            saw_image = True
    if saw_image and not saw_text:
        return "image"
    return "pass"


def choose_mime(names: list[str]) -> str | None:
    by_low = {name.lower(): name for name in names}
    for mime in IMAGE_MIMES:
        if mime.lower() in by_low:
            return by_low[mime.lower()]
    for name in names:
        if name.lower().startswith("image/"):
            return name
    return None


@dataclass
class Stroke:
    tool: str
    color: tuple[int, int, int]
    width: float
    points: list[tuple[float, float]] = field(default_factory=list)
    box: tuple[float, float, float, float] | None = None


def _fill(color: tuple[int, int, int]) -> tuple[int, int, int, int]:
    return (color[0], color[1], color[2], 255)


def _draw_line(draw: ImageDraw.ImageDraw, pts, fill, width: int) -> None:
    if len(pts) == 1:
        x, y = pts[0]
        r = width / 2
        draw.ellipse((x - r, y - r, x + r, y + r), fill=fill)
        return
    try:
        draw.line(pts, fill=fill, width=width, joint="curve")
    except TypeError:
        draw.line(pts, fill=fill, width=width)
    r = width / 2
    for x, y in (pts[0], pts[-1]):
        draw.ellipse((x - r, y - r, x + r, y + r), fill=fill)


def _draw_arrow(draw: ImageDraw.ImageDraw, x1, y1, x2, y2, fill, width: int) -> None:
    dx, dy = x2 - x1, y2 - y1
    length = math.hypot(dx, dy)
    if length < 1:
        return
    ang = math.atan2(dy, dx)
    head = min(max(width * 3.4, 12 + width), length * 0.72)
    wing = head * 0.58
    inset = head * 0.55
    sx = x2 - math.cos(ang) * inset
    sy = y2 - math.sin(ang) * inset
    _draw_line(draw, [(x1, y1), (sx, sy)], fill, width)
    bx = x2 - math.cos(ang) * head
    by = y2 - math.sin(ang) * head
    px = math.cos(ang + math.pi / 2) * wing
    py = math.sin(ang + math.pi / 2) * wing
    draw.polygon([(x2, y2), (bx + px, by + py), (bx - px, by - py)], fill=fill)


def draw_strokes(image: Image.Image, strokes: list[Stroke], scale: float) -> None:
    draw = ImageDraw.Draw(image)
    for stroke in strokes:
        width = max(1, int(round(stroke.width * scale)))
        fill = _fill(stroke.color)
        if stroke.tool == "pen" and stroke.points:
            pts = [(p[0] * scale, p[1] * scale) for p in stroke.points]
            _draw_line(draw, pts, fill, width)
        elif stroke.tool == "arrow" and stroke.box:
            x1, y1, x2, y2 = stroke.box
            _draw_arrow(draw, x1 * scale, y1 * scale, x2 * scale, y2 * scale, fill, width)
        elif stroke.tool == "circle" and stroke.box:
            x1, y1, x2, y2 = stroke.box
            left, right = sorted((x1, x2))
            top, bottom = sorted((y1, y2))
            if right - left < 1 and bottom - top < 1:
                continue
            draw.ellipse(
                (left * scale, top * scale, right * scale, bottom * scale),
                outline=fill,
                width=width,
            )


def pil_to_pixbuf(image: Image.Image):
    rgba = image.convert("RGBA")
    data = rgba.tobytes()
    w, h = rgba.size
    pixbuf = GdkPixbuf.Pixbuf.new_from_bytes(
        GLib.Bytes.new(data),
        GdkPixbuf.Colorspace.RGB,
        True,
        8,
        w,
        h,
        w * 4,
    )
    return pixbuf, data


def fit_scale(img_w: int, img_h: int, max_w: int, max_h: int) -> float:
    if img_w < 1 or img_h < 1:
        return 1.0
    fit = min(max_w / img_w, max_h / img_h)
    if fit >= 1:
        if max(img_w, img_h) < 480:
            return min(2.0, fit)
        return 1.0
    return fit


